  .plate-guide span{ left:7px; bottom:7px; color:#F1D89B; border-color:rgba(215,174,104,.20); }
  .scan-line{ position:absolute; left:14%; right:14%; top:16%; height:2px; background:linear-gradient(90deg,transparent,rgba(95,227,224,.88),transparent); filter:drop-shadow(0 0 6px rgba(95,227,224,.65)); animation:gateScanMove 3.8s linear infinite; }
  @keyframes gateScanMove{ 0%{transform:translate3d(0,0,0);} 50%{transform:translate3d(0,170px,0);} 100%{transform:translate3d(0,340px,0);} }
  .video-empty-state{ position:absolute; inset:0; z-index:4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:7px; text-align:center; color:rgba(241,245,251,.82); background:radial-gradient(circle at 50% 50%,rgba(15,25,45,.12),rgba(2,5,10,.48)); transition:opacity .25s ease; padding:24px; }
