  .qa-grid{ display:flex; flex-direction:column; gap:9px; padding:16px; }
  .qa-btn{
    display:flex; align-items:center; gap:10px; padding:11px 13px; border-radius:10px;
    background:rgba(15,23,42,.025); border:1px solid var(--border-glass); color:var(--text-1);
    font-size:12.5px; font-weight:600; transition:border-color .15s, background .15s;
  }
  .qa-btn:hover{ border-color:rgba(30,64,175,.4); background:var(--gold-dim); }
  .qa-btn svg{ width:16px; height:16px; flex:none; }
