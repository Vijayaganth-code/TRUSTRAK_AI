  class TollGraph{
    constructor(){ this.adj = {}; }
    addEdge(a,b,d){ (this.adj[a]=this.adj[a]||[]).push({to:b,d}); (this.adj[b]=this.adj[b]||[]).push({to:a,d}); }
    shortest(a,b){
      if(a===b) return 0;
      const dist={}; Object.keys(this.adj).forEach(n=>dist[n]=Infinity); dist[a]=0;
      const seen=new Set(); let q=[[0,a]];
      while(q.length){
        q.sort((x,y)=>x[0]-y[0]);
        const [d,node]=q.shift();
        if(seen.has(node)) continue; seen.add(node);
        if(node===b) return d;
        (this.adj[node]||[]).forEach(e=>{ const nd=d+e.d; if(nd<dist[e.to]){ dist[e.to]=nd; q.push([nd,e.to]); } });
      }
      return dist[b]===Infinity ? null : dist[b];
    }
  }
