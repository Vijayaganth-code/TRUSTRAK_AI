  .data-dot{ width:6px; height:6px; border-radius:50%; background:var(--blue); }
  .gate-control-bar{ display:grid; grid-template-columns:minmax(250px,1.35fr) minmax(150px,.72fr) minmax(190px,.82fr) minmax(250px,1.15fr); gap:10px; align-items:stretch; }
  .gate-select-wrap label,.journey-selector-wrap label{ display:block; margin:0 0 6px; font-size:9px; text-transform:uppercase; letter-spacing:.8px; color:var(--text-3); font-weight:700; }
  .gate-select{ width:100%; appearance:none; background:var(--glass-strong); color:var(--text-1); border:1px solid var(--border-glass); border-radius:9px; padding:10px 32px 10px 11px; font:600 11.5px var(--font-body); outline:none; background-image:linear-gradient(45deg,transparent 50%,var(--text-3) 50%),linear-gradient(135deg,var(--text-3) 50%,transparent 50%); background-position:calc(100% - 13px) 14px,calc(100% - 9px) 14px; background-size:4px 4px,4px 4px; background-repeat:no-repeat; }
  .gate-select:focus{ border-color:var(--gold); }
