  async function createAnprEvent(ocr, observedType, source='camera'){
    const raw=ocr?.text||'';
    const match=ocr?.match||matchRegistryPlate(raw);
    const plate=match?.plate || displayPlate(raw);
    const normalized=normalizePlate(plate || raw);
    if(!normalized){
      toast('No usable registration was read from this frame.');
      return null;
    }

    const type=observedType||'Unknown';
    const event={
      id:'EV-'+Date.now()+'-'+Math.random().toString(36).slice(2,7),
      timestamp:new Date().toISOString(),
      gate:currentGate(),
      cameraId:currentCameraId(),
      plate,
      normalizedPlate:normalized,
      vehicleType:type,
      confidence:Number.isFinite(ocr?.confidence)?Number(ocr.confidence):0,
      registryMatch:false,
      registrySnapshot:null,
      status:'Checking registry…',
      source
    };

    latestGateDetection=event;
    renderLatestDetection(event);
    setDetectionState('OCR READ · CHECKING REGISTRY');
    setPipelineStep('stepLookup','busy');
    setPipelineStep('stepRecord','busy');

    try{
      if(!window.TRUSTRAK_API?.recordAnpr){
        throw new Error('Local FastAPI bridge is not available.');
      }

      // Let the backend be authoritative for registry matching.
      // The API itself assigns UNKNOWN_REGISTRY when the plate is absent.
      const result=await window.TRUSTRAK_API.recordAnpr({
        registration_number:normalized,
        camera_id:event.cameraId,
        location:event.gate,
        timestamp:event.timestamp,
        detected_vehicle_type:event.vehicleType,
        detected_colour:null,
        ocr_confidence:Math.max(0,Math.min(1,Number(event.confidence||0)/100)),
        event_type:'NORMAL'
      });

      let backendVehicle=result?.vehicle || null;
      let backendRisk=result?.risk_analysis || null;

      // Explicit backend lookups make the scan independent of the browser's
      // small demo registry and remove the previous async UI race condition.
      if(!backendVehicle){
        try{
          const lookup=await window.TRUSTRAK_API.get('/api/vehicles/'+encodeURIComponent(normalized));
          backendVehicle=lookup?.vehicle || lookup || null;
        }catch(e){
          console.warn('Vehicle lookup fallback failed:',e);
        }
      }

      if(!backendRisk){
        try{
          backendRisk=await window.TRUSTRAK_API.get('/api/risk/live/'+encodeURIComponent(normalized));
        }catch(e){
          console.warn('Risk lookup fallback failed:',e);
        }
      }

      if(backendVehicle){
        const v=backendVehicle;
        event.plate=v.registration_number || normalized;
        event.normalizedPlate=normalizePlate(event.plate);
        event.registryMatch=true;
        event.registrySnapshot={
          colour:v.registered_colour || null,
          type:v.vehicle_type || 'Unknown',
          permit:v.permit_status || '—',
          fitness:v.fitness_status || '—',
          fastag:(v.fastag_id || '—') + (v.fastag_status ? ' / ' + v.fastag_status : ''),
          operator:v.operator || '—'
        };
        event.riskAnalysis=backendRisk || result?.risk_analysis || null;
        event.status='REGISTRY MATCH';
      }else{
        event.registryMatch=false;
        event.status='Unknown';
      }

      anprEvents.push(event);
      if(anprEvents.length>MAX_EVENT_HISTORY){
        anprEvents=anprEvents.slice(-MAX_EVENT_HISTORY);
      }
      saveAnprEvents();

      latestGateDetection=event;
      renderLatestDetection(event);
      renderAnprEventHistory();
      renderJourneyVehicleOptions(event.normalizedPlate);
      const sel=document.getElementById('journeyVehicleSelect');
      if(sel) sel.value=event.normalizedPlate;
      renderJourneyAnalysis();
      document.getElementById('lastCaptureReadout').textContent=safeTimeString(event.timestamp);

      setPipelineStep('stepLookup','done');
      setPipelineStep('stepRecord','done');

      if(event.registryMatch){
        setDetectionState('EVENT RECORDED · REGISTRY MATCH');
        toast(`${event.plate} matched the backend vehicle registry.`);
      }else{
        setDetectionState('EVENT RECORDED · NO REGISTRY MATCH');
        toast(`${event.plate} was recorded, but no backend registry record was found.`);
      }

      window.dispatchEvent(new CustomEvent('trustrak-anpr-recorded',{detail:result}));
      return event;
    }catch(err){
      console.error('TRUSTRAK backend ANPR enrichment failed:',err);
      event.status='Backend sync error';
      setDetectionState('ANPR BACKEND SYNC ERROR');
      toast('ANPR was read, but backend vehicle lookup failed. Check the local API connection.');
      return event;
    }
  }

  async function getOcrWorker(){
    if(physicalOcrWorker) return physicalOcrWorker;
    if(physicalModelsLoading) return physicalModelsLoading.then(()=>physicalOcrWorker);
    physicalModelsLoading=(async()=>{
      if(!window.Tesseract) throw new Error('Tesseract library unavailable');
      setGateStatus('LOADING OCR MODEL…','busy');
      const worker=await Tesseract.createWorker('eng');
      await worker.setParameters({
        tessedit_char_whitelist:'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',
        tessedit_pageseg_mode:'7',
        preserve_interword_spaces:'0'
      });
      physicalOcrWorker=worker;
      return worker;
    })().finally(()=>{ physicalModelsLoading=null; });
    return physicalModelsLoading;
  }
