    }
  })();
  (function buildSkyline(){
    let x = -700;
    while(x < 2600){
      const w = 40 + Math.random()*60, h = 30 + Math.random()*110;
      skylineGroup.appendChild(makeEl("rect", {x:x.toFixed(1), y:(500-h).toFixed(1), width:w.toFixed(1), height:h.toFixed(1), fill:"#0B1526"}));
      if(Math.random() < 0.6){
        skylineGroup.appendChild(makeEl("rect", {x:(x+w*0.3).toFixed(1), y:(500-h+h*0.3).toFixed(1), width:5, height:5, fill:"#E8C170", opacity:.5}));
      }
      x += w + 14 + Math.random()*30;
    }
  })();
  (function buildRoadDashes(){
    for(let i=0;i<9;i++){
      const t = i/8, y = 520 + t*180, halfW = 4 + t*10, cx = 1010;
      roadDashGroup.appendChild(makeEl("rect", {x:(cx-halfW/2).toFixed(1), y:y.toFixed(1), width:halfW.toFixed(1), height:(10+t*8).toFixed(1), fill:"#fff", opacity:(0.15+t*0.15).toFixed(2)}));
    }
  })();

  /* ---------- camera flight: fast, continuous cinematic movement ---------- */
  // A single smooth trajectory avoids the stop/start velocity changes caused by
  // easing every intermediate keyframe. The camera follows one cubic Bezier path
  // while the view box shrinks on a logarithmic scale for a much faster, smoother zoom.
  const FLIGHT_MS = 3300;
  const CAM_START = { cx: 1000, cy: 610, w: 3400, h: 2260 };
  const CAM_END   = { cx: 1010, cy: 904, w: 112,  h: 100 };
  const CAM_C1    = { cx: 1000, cy: 655 };
  const CAM_C2    = { cx: 1012, cy: 805 };

  function lerp(a,b,t){ return a + (b-a)*t; }
  function smoothCubic(t){
    t = Math.max(0, Math.min(1, t));
    return t*t*(3-2*t);
  }
  function cubicBezier(a,b,c,d,t){
    const u = 1-t;
    return (u*u*u*a) + (3*u*u*t*b) + (3*u*t*t*c) + (t*t*t*d);
  }
  function logLerp(a,b,t){
    return a * Math.pow(b/a, t);
  }
  function cameraAt(progress){
    const p = smoothCubic(progress);
    const cx = cubicBezier(CAM_START.cx, CAM_C1.cx, CAM_C2.cx, CAM_END.cx, p);
    const cy = cubicBezier(CAM_START.cy, CAM_C1.cy, CAM_C2.cy, CAM_END.cy, p);
    return {
      x: cx - logLerp(CAM_START.w, CAM_END.w, p)/2,
      y: cy - logLerp(CAM_START.h, CAM_END.h, p)/2,
      w: logLerp(CAM_START.w, CAM_END.w, p),
      h: logLerp(CAM_START.h, CAM_END.h, p)
    };
  }
  let flightStart = null;
  function flightStep(now){
    if(stopFlight) return;
    if(flightStart === null) flightStart = now;
    const p = Math.min((now-flightStart)/FLIGHT_MS, 1);
    const c = cameraAt(p);
    // Barely perceptible parallax: enough to feel cinematic, never enough to look shaky.
    const micro = (1-p) * 0.16;
    const jx = Math.sin(now/1650) * micro;
    const jy = Math.cos(now/1750) * micro;
    cineSvg.setAttribute('viewBox',
      `${(c.x+jx).toFixed(2)} ${(c.y+jy).toFixed(2)} ${c.w.toFixed(2)} ${c.h.toFixed(2)}`
    );
    if(p < 1) requestAnimationFrame(flightStep);
    else { flightStart = null; onFlightSettled(); }
  }
  function onFlightSettled(){
    openTitle.classList.remove('show');
    setTimeout(()=>{if(introDone)return;traceLine.classList.add('show');setTimeout(()=>traceLine.classList.remove('show'),1100);},100);
    setTimeout(()=>{if(introDone)return;hudTags.querySelectorAll('.hud-tag').forEach((tag,i)=>setTimeout(()=>tag.classList.add('show'),i*70));scanRing.classList.add('show');},650);
    setTimeout(()=>{if(introDone)return;tyreHotspot.classList.add('ready');tyreHint.classList.add('show');enterLink.classList.add('show');},1200);
  }

  /* ---------- loading sequence ---------- */
  const BOOT_LINES = [
    "INITIALIZING VEHICLE INTEGRITY SYSTEM…",
    "LOADING ENVIRONMENT…",
    "CALIBRATING ANPR…",
    "CONNECTING VEHICLE INTELLIGENCE…",
    "SYSTEM READY"
  ];
  function blockBar(pct){
    const total = 20, filled = Math.round((pct/100)*total);
    return "█".repeat(filled) + "░".repeat(total-filled) + " " + pct + "%";
  }
  function runLoading(){
    let pct=0; const pctTimer=setInterval(()=>{pct=Math.min(pct+10,100);bootPct.textContent=blockBar(pct);if(pct>=100)clearInterval(pctTimer);},42);
    setTimeout(()=>{bootBar.style.width='100%';},30);
    BOOT_LINES.forEach((line,i)=>setTimeout(()=>{const div=document.createElement('div');div.className='boot-line';div.innerHTML=i===BOOT_LINES.length-1?`<span class="ok">${line}</span>`:line;bootLog.appendChild(div);},90+i*135));
    setTimeout(()=>{loadingScreen.classList.add('hide');setTimeout(()=>loadingScreen.style.display='none',420);cineScene.classList.add('show');requestAnimationFrame(flightStep);},90+BOOT_LINES.length*135+210);
  }

  /* ---------- audio (synthesized ambience, muted by default) ---------- */
  let audioCtx = null, masterGain = null, ambientStarted = false, soundOn = false;
  function ensureAudio(){
    if(audioCtx) return;
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    masterGain = audioCtx.createGain();
    masterGain.gain.value = 0;
    masterGain.connect(audioCtx.destination);
  }
  function startAmbient(){
    if(ambientStarted) return;
    ambientStarted = true;
    const o1 = audioCtx.createOscillator(); o1.type = "sine"; o1.frequency.value = 58;
    const o2 = audioCtx.createOscillator(); o2.type = "sine"; o2.frequency.value = 87;
    const g = audioCtx.createGain(); g.gain.value = 0.5;
    const lp = audioCtx.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 300;
    o1.connect(lp); o2.connect(lp); lp.connect(g); g.connect(masterGain);
    o1.start(); o2.start();

    const bufferSize = audioCtx.sampleRate * 2;
    const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
    const data = buffer.getChannelData(0);
    for(let i=0;i<bufferSize;i++) data[i] = (Math.random()*2-1) * 0.3;
    const noise = audioCtx.createBufferSource(); noise.buffer = buffer; noise.loop = true;
    const noiseFilter = audioCtx.createBiquadFilter(); noiseFilter.type = "bandpass"; noiseFilter.frequency.value = 400; noiseFilter.Q.value = 0.6;
    const noiseGain = audioCtx.createGain(); noiseGain.gain.value = 0.12;
    noise.connect(noiseFilter); noiseFilter.connect(noiseGain); noiseGain.connect(masterGain);
    noise.start();
  }
  function playBlip(){
    if(!soundOn || !audioCtx) return;
    const o = audioCtx.createOscillator(); o.type = "sine";
    const g = audioCtx.createGain(); g.gain.value = 0.0001;
    o.connect(g); g.connect(masterGain);
    const t = audioCtx.currentTime;
    o.frequency.setValueAtTime(720, t);
    o.frequency.exponentialRampToValueAtTime(1200, t+.12);
    g.gain.exponentialRampToValueAtTime(0.12, t+.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t+.25);
    o.start(t); o.stop(t+.3);
  }
  function playWhoosh(){
    if(!soundOn || !audioCtx) return;
    const bufferSize = audioCtx.sampleRate * 1.2;
    const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
    const data = buffer.getChannelData(0);
    for(let i=0;i<bufferSize;i++) data[i] = (Math.random()*2-1);
    const noise = audioCtx.createBufferSource(); noise.buffer = buffer;
    const filter = audioCtx.createBiquadFilter(); filter.type = "bandpass"; filter.Q.value = 0.8;
    const g = audioCtx.createGain();
    const t = audioCtx.currentTime;
    filter.frequency.setValueAtTime(200, t);
    filter.frequency.exponentialRampToValueAtTime(4200, t+.9);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.4, t+.15);
    g.gain.exponentialRampToValueAtTime(0.0001, t+1.1);
    noise.connect(filter); filter.connect(g); g.connect(masterGain);
    noise.start(t); noise.stop(t+1.2);

    const thump = audioCtx.createOscillator(); thump.type = "sine"; thump.frequency.value = 48;
    const tg = audioCtx.createGain();
    tg.gain.setValueAtTime(0.35, t+.6); tg.gain.exponentialRampToValueAtTime(0.0001, t+1.1);
    thump.connect(tg); tg.connect(masterGain);
    thump.start(t+.6); thump.stop(t+1.15);
  }
  function setSound(on){
    soundOn = on;
    ensureAudio();
    if(audioCtx.state === "suspended") audioCtx.resume();
    masterGain.gain.setTargetAtTime(on ? 0.55 : 0, audioCtx.currentTime, 0.4);
    if(on) startAmbient();
    soundToggle.setAttribute("aria-pressed", String(on));
    soundLabel.textContent = on ? "Sound on" : "Sound off";
    document.getElementById("muteSlash").style.display = on ? "none" : "";
    document.getElementById("muteSlash2").style.display = on ? "none" : "";
  }
  soundToggle.addEventListener("click", () => setSound(!soundOn));

  /* ---------- tyre hover feedback ---------- */
  function setTyreHover(on){
    heroTyreGroup.classList.toggle("hovered", on);
    scanRing.classList.toggle("hovered", on);
    rimSpin.classList.toggle("hovered", on);
  }
  tyreHotspot.addEventListener("pointerenter", () => { setTyreHover(true); playBlip(); });
  tyreHotspot.addEventListener("pointerleave", () => setTyreHover(false));
  tyreHotspot.addEventListener("focus", () => { setTyreHover(true); playBlip(); });
  tyreHotspot.addEventListener("blur", () => setTyreHover(false));

  /* ---------- click -> portal transition ---------- */
  let entering = false;
  function enterDashboard(){
    if(entering || introDone) return;
    entering = true;
    tyreHint.classList.remove("show");
    hudTags.querySelectorAll(".hud-tag").forEach(t => t.classList.remove("show"));
    scanRing.classList.remove("show");
    enterLink.classList.remove("show");
    introDisclaimer.classList.remove("show");
    playWhoosh();
    rimSpin.classList.add("accelerate");

    stopFlight = true;
    const diveStart = performance.now();
    const camFrom = cameraAt(1);
    const camTo = { x:990, y:885, w:40, h:36 };
    function dive(now){
      const p = Math.min((now-diveStart)/380, 1);
      const e = p*p*(3-2*p);
      const x = lerp(camFrom.x, camTo.x, e), y = lerp(camFrom.y, camTo.y, e);
      const w = lerp(camFrom.w, camTo.w, e), h = lerp(camFrom.h, camTo.h, e);
      cineSvg.setAttribute("viewBox", `${x.toFixed(1)} ${y.toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`);
      if(p < 1) requestAnimationFrame(dive);
      else {
        portalIris.classList.add("expand");
        setTimeout(() => {
          finishIntro();
          setTimeout(() => portalIris.classList.add("fade"), 150);
        }, 360);
      }
    }
    requestAnimationFrame(dive);
  }
  tyreHotspot.addEventListener("click", enterDashboard);
  enterLink.addEventListener("click", e => { e.preventDefault(); enterDashboard(); });

  skipBtn.addEventListener("click", () => {
    stopFlight = true;
    finishIntro();
  });

  /* ---------- retained plate utilities used by gate ANPR ---------- */
  function normalizePlate(raw){
    return String(raw||'')
      .toUpperCase()
      .replace(/[|]/g,'I')
      .replace(/[\u2010\u2011\u2012\u2013\u2014]/g,'-')
      .replace(/^IND(?=[A-Z0-9])/,'')
      .replace(/[^A-Z0-9]/g,'');
  }
  function displayPlate(raw){
    const n=normalizePlate(raw);
    if(!n) return '—';
    if(n.length>=10 && /^TN/.test(n)) return n.slice(0,2)+' '+n.slice(2,4)+' '+n.slice(4,6)+' '+n.slice(6);
    return n;
  }
  function confusionDistance(a,b){
    const x=normalizePlate(a), y=normalizePlate(b);
    if(!x || !y) return Infinity;
    const groups=[['0','O','D','Q'],['1','I','L'],['2','Z'],['5','S'],['6','G'],['8','B'],['9','G']];
    const equiv=(a,b)=>a===b || groups.some(g=>g.includes(a)&&g.includes(b));
    const dp=Array.from({length:x.length+1},(_,i)=>i);
    for(let j=1;j<=y.length;j++){
      let prev=dp[0]; dp[0]=j;
      for(let i=1;i<=x.length;i++){
        const old=dp[i];
        dp[i]=Math.min(dp[i]+1,dp[i-1]+1,prev+(equiv(x[i-1],y[j-1])?0:.7));
        prev=old;
      }
    }
    return dp[x.length];
  }
  function matchRegistryPlate(raw){
    const n=normalizePlate(raw);
    if(!n) return null;
    const keys=Object.keys(VEHICLE_REGISTRY);
    const exact=keys.find(p=>normalizePlate(p)===n);
    if(exact) return {plate:exact,reg:VEHICLE_REGISTRY[exact],distance:0};
    let best=null;
    for(const p of keys){
      const pn=normalizePlate(p);
      if(!pn || Math.abs(pn.length-n.length)>2) continue;
      if(/^TN/.test(pn) && !/^TN/.test(n) && n.length<7) continue;
      const d=confusionDistance(n,pn);
      const maxAllowed=n.length>=9?2.35:(n.length>=7?1.45:1.0);
      if(d<=maxAllowed && (!best || d<best.distance)) best={plate:p,reg:VEHICLE_REGISTRY[p],distance:d};
    }
    return best;
  }
  function vehicleTypeShort(type){
    const t=String(type||'').toLowerCase();
    if(t.includes('truck')) return 'Truck';
    if(t.includes('motorcycle')||t.includes('motorbike')||t.includes('bike')) return 'Motorcycle';
    if(t.includes('bus')) return 'Bus';
    if(t.includes('car')) return 'Car';
    return type||'Unknown';
  }

  introDisclaimer.classList.add("show");
  runLoading();

})();
</script>

<!-- =========================================================
     TRUSTRAK LIVE API BRIDGE
     Connects the polished UI to the local FastAPI backend.
