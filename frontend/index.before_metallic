  function detectionFromPredictions(predictions){
    const list=(predictions||[]).filter(p=>VEHICLE_CLASSES.includes(p.class) && Number(p.score)>=0.50);
    list.sort((a,b)=>(b.score||0)-(a.score||0));
    return list[0]||null;
  }
  function detectionSignature(det){
    if(!det) return '';
    const [x,y,w,h]=det.bbox||[0,0,0,0];
    return `${det.class}:${Math.round((x+w/2)/40)}:${Math.round((y+h/2)/40)}:${Math.round(w/45)}:${Math.round(h/45)}`;
  }
  function clamp(v,min,max){ return Math.max(min,Math.min(max,v)); }
  function cropCanvas(video,bbox,mode=0){
    const vw=video.videoWidth,vh=video.videoHeight;
    const [x,y,w,h]=bbox;
    const sx=clamp(x,0,vw), sy=clamp(y,0,vh), sw=clamp(w,40,vw-sx), sh=clamp(h,40,vh-sy);
    const c=document.createElement('canvas');
    c.width=Math.max(760,Math.round(sw*2.3)); c.height=Math.max(380,Math.round(sh*2.3));
    const ctx=c.getContext('2d',{willReadFrequently:true});
    ctx.drawImage(video,sx,sy,sw,sh,0,0,c.width,c.height);
    if(mode===0) return c;
    const img=ctx.getImageData(0,0,c.width,c.height);
    for(let i=0;i<img.data.length;i+=4){
      const r=img.data[i],g=img.data[i+1],b=img.data[i+2];
      const gray=.299*r+.587*g+.114*b;
      let v=gray;
      if(mode===1) v=clamp((gray-110)*1.8+130,0,255);
      else v=gray>155?255:gray<85?0:Math.round((gray-85)*3.65);
      img.data[i]=img.data[i+1]=img.data[i+2]=v;
    }
    ctx.putImageData(img,0,0);
    return c;
  }
  function plateCropCandidates(video,det){
    const vw=video.videoWidth,vh=video.videoHeight;
    if(det){
      const [x,y,w,h]=det.bbox;
      const lowerY=y+h*.42;
      const lowerH=h*.55;
      const full=[x+w*.05, lowerY, w*.90, lowerH];
      const center=[x+w*.18, y+h*.48, w*.64, h*.40];
      return [full,center,[vw*.18,vh*.48,vw*.64,vh*.42]];
    }
    return [[vw*.15,vh*.48,vw*.70,vh*.40],[vw*.08,vh*.55,vw*.84,vh*.33]];
  }
  async function ocrVehicle(video,det){
    // FAST OCR MODE:
    // The old implementation ran up to 18 Tesseract recognitions per capture,
    // which can keep the UI on "CAPTURING ANPR…" for a long time on a laptop.
    // Start with the visible plate guide, then use only a small fallback set.
    const worker=await getOcrWorker();
    const candidates=[];
    const vw=video.videoWidth, vh=video.videoHeight;
    const guide=[vw*0.26, vh*0.46, vw*0.48, vh*0.30];
    const boxes=det
      ? [guide, ...plateCropCandidates(video,det).slice(0,1)]
      : [guide, [vw*0.18, vh*0.48, vw*0.64, vh*0.32]];

    // Try the natural crop first, then one contrast-enhanced crop.
    for(let bIndex=0;bIndex<boxes.length;bIndex++){
      for(const prep of bIndex===0 ? [0,1] : [0]){
        const canvas=cropCanvas(video,boxes[bIndex],prep);
        await worker.setParameters({
          tessedit_pageseg_mode:'7',
          tessedit_char_whitelist:'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',
          preserve_interword_spaces:'0'
        });
        const r=await worker.recognize(canvas);
        const raw=String(r.data?.text||'');
        const text=normalizePlate(raw);
        const confidence=Number(r.data?.confidence||0);
        if(text){
          const match=matchRegistryPlate(text);
          const quality=(match?(10000-(match.distance*100)):0)+(confidence*2)+(text.length>=8?200:0)+(bIndex===0?35:0);
          candidates.push({text,confidence,match,quality});
          if(match && match.distance===0) return {text,confidence,match};
        }
      }
    }

    // One last sparse-text pass only if the fast path did not find a result.
    if(candidates.length){
      const best=candidates.sort((a,b)=>b.quality-a.quality)[0];
      if(best.match || best.text.length>=7) return best;
    }

    return {text:'',confidence:0,match:null};
  }

  async function getCurrentVehicleDetection(){
    if(!physicalDetector || !physicalVideo.videoWidth) return null;
    try{
      const predictions=await physicalDetector.detect(physicalVideo);
      return detectionFromPredictions(predictions);
    }catch(e){ console.warn('Vehicle detection failed',e); return null; }
