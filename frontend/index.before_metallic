  .search-box input::placeholder{ color:var(--text-3); }
  .search-results{
    position:absolute; top:calc(100% + 6px); left:0; right:0; background:var(--glass-strong); border:1px solid var(--border-glass);
    border-radius:10px; overflow:hidden; z-index:5; display:none;
  }
  .search-results.open{ display:block; }
  .search-result{ padding:10px 14px; font-size:12.5px; display:flex; justify-content:space-between; gap:10px; border-top:1px solid var(--border-glass-2); cursor:pointer; }
  .search-result:first-child{ border-top:none; }
  .search-result:hover{ background:rgba(15,23,42,.035); }
  .search-result .plate{ color:var(--text-1); font-weight:600; }
  .search-result .meta{ color:var(--text-3); font-size:11px; }

  .filter-chip{
    padding:7px 14px; border-radius:20px; font-size:11.5px; font-weight:600; border:1px solid var(--border-glass);
    background:var(--glass); color:var(--text-2);
  }
  .filter-chip.active{ background:var(--gold-dim); color:var(--gold-bright); border-color:rgba(30,64,175,.3); }

  .id-card{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:0; }
  .id-card .idf{ padding:14px 16px; border-right:1px solid var(--border-glass-2); border-top:1px solid var(--border-glass-2); }
