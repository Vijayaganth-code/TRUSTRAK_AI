  /* ---------- footer ---------- */
  footer.disclaimer-foot{ margin-top:22px; padding-top:16px; border-top:1px solid var(--border-glass-2); }
  .disclaimer{ font-size:10px; color:var(--text-3); line-height:1.65; max-width:900px; }

  /* ---------- modal ---------- */
  .modal-overlay{
    position:fixed; inset:0; background:rgba(3,6,12,.72); backdrop-filter:blur(4px);
    display:flex; align-items:center; justify-content:center; z-index:80; padding:24px;
    opacity:0; pointer-events:none; transition:opacity .2s ease;
  }
  .modal-overlay.open{ opacity:1; pointer-events:auto; }
  .modal-box{
    width:640px; max-width:100%; max-height:86vh; overflow-y:auto;
    background:var(--glass-strong); border:1px solid var(--border-glass); border-radius:16px;
    padding:22px 24px 24px; transform:translateY(10px); transition:transform .2s ease;
  }
  .modal-overlay.open .modal-box{ transform:translateY(0); }
  .modal-head{ display:flex; align-items:flex-start; justify-content:space-between; gap:14px; }
  .modal-case-id{ font-size:10.5px; color:var(--text-3); letter-spacing:.4px; }
  .modal-plate{ font-family:var(--font-display); font-size:23px; font-weight:700; margin-top:2px; }
  .modal-close{ width:30px; height:30px; border-radius:8px; background:rgba(15,23,42,.04); border:1px solid var(--border-glass); color:var(--text-2); display:flex; align-items:center; justify-content:center; flex:none; }
  .modal-close svg{ width:14px; height:14px; }
  .modal-close:hover{ color:var(--text-1); border-color:rgba(15,23,42,.25); }

  .modal-section{ margin-top:18px; }
  .modal-section-title{ font-size:11px; letter-spacing:.3px; color:var(--text-2); font-weight:600; margin-bottom:9px; }
  .reason-list{ display:flex; flex-direction:column; gap:6px; }
  .reason-row{ display:flex; justify-content:space-between; gap:10px; font-size:12px; padding:8px 10px; border-radius:8px; background:rgba(15,23,42,.03); }
  .reason-row .rw{ font-family:var(--font-display); font-weight:700; color:var(--gold-bright); }
  .reason-total{ display:flex; justify-content:space-between; margin-top:8px; padding-top:8px; border-top:1px solid var(--border-glass-2); font-size:12.5px; font-weight:700; }

  .sight-row{ display:flex; gap:12px; align-items:center; font-size:11.5px; padding:8px 0; }
  .sight-row + .sight-row{ border-top:1px solid var(--border-glass-2); }
  .sight-cam{ font-family:var(--font-display); font-weight:700; color:var(--text-1); width:118px; flex:none; }
  .sight-loc{ color:var(--text-2); flex:1; }
  .sight-time{ color:var(--text-2); flex:none; }
  .sight-conf{ color:var(--text-3); flex:none; width:56px; text-align:right; }
  .travel-note{ margin-top:8px; font-size:11.5px; color:var(--text-2); background:rgba(239,93,93,.08); border:1px solid rgba(239,93,93,.2); padding:9px 11px; border-radius:8px; }
  .travel-note b{ color:var(--red); }

  .compare-table{ width:100%; font-size:12px; border-collapse:collapse; }
  .compare-table th{ padding:0 0 7px; font-size:10px; color:var(--text-3); font-weight:600; text-align:left; }
  .compare-table td{ padding:6px 0; border-top:1px solid var(--border-glass-2); color:var(--text-1); }
  .compare-table td.mismatch{ color:var(--red); font-weight:600; }

  .decision-grid{ margin-top:9px; display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .decision-btn{
    padding:9px 10px; border-radius:9px; font-size:11px; font-weight:600; text-align:center;
    background:rgba(15,23,42,.025); border:1px solid var(--border-glass); color:var(--text-1);
    transition:border-color .15s, background .15s;
  }
  .decision-btn:hover{ border-color:rgba(30,64,175,.4); background:var(--gold-dim); }
  .decision-btn.dec-good{ border-color:rgba(62,203,138,.3); color:var(--green); }
  .decision-btn.dec-bad{ border-color:rgba(239,93,93,.3); color:var(--red); }

  .modal-simtag{ margin-top:16px; font-size:9.5px; color:var(--text-3); }

  /* ---------- search page ---------- */
  .search-row{ position:relative; }
  .search-box{
    display:flex; align-items:center; gap:10px; background:var(--glass); border:1px solid var(--border-glass);
    border-radius:10px; padding:11px 14px; backdrop-filter:blur(14px);
  }
  .search-box:focus-within{ border-color:var(--gold); }
  .search-box svg{ width:15px; height:15px; color:var(--text-3); flex:none; }
