<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TRUSTRAK AI — Commercial Vehicle Integrity &amp; Fraud Detection</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-void:#F7F9FC;
    --bg-1:#FFFFFF;
    --bg-2:#EEF2F7;
    --glass:rgba(255,255,255,.86);
    --glass-strong:rgba(255,255,255,.97);
    --border-glass:rgba(15,23,42,.10);
    --border-glass-2:rgba(15,23,42,.06);
    --text-1:#F1F5FB;
    --text-2:#8FA0BC;
    --text-3:#54637C;
    --gold:#D7AE68;
    --gold-bright:#F1D89B;
    --gold-dim:rgba(215,174,104,.15);
    --green:#178A50; --green-dim:rgba(23,138,80,.12);
    --amber:#96570A; --amber-dim:rgba(150,87,10,.12);
    --red:#D33A3A; --red-dim:rgba(211,58,58,.12);
    --blue:#2A6FE0; --blue-dim:rgba(42,111,224,.12);
    --purple:#7550D6; --purple-dim:rgba(117,80,214,.12);
    --font-display:'Sora', sans-serif;
    --font-body:'Inter', sans-serif;
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(42,111,224,.05), transparent 60%),
      radial-gradient(ellipse 900px 600px at 100% 0%, rgba(23,138,80,.04), transparent 55%),
      var(--bg-void);
    color:var(--text-1);
    font-family:var(--font-body);
    min-height:100vh;
  }
  /* The intro is a night scene and keeps the warm/dark tokens above.
     Everything inside #app gets its own light-theme tokens here, so the
     intro's colors (which reuse --gold/--text-*) are left completely alone.
     #toastStack and #printReportArea are siblings of #app (not descendants),
     so they need the same override explicitly or they'd inherit the dark-theme
     text color straight from :root. */
  #app, #toastStack{
    --text-1:#0F172A;
    --text-2:#4B5768;
    --text-3:#64748B;
    --gold:#1E40AF;
    --gold-bright:#2F5FD6;
    --gold-dim:rgba(30,64,175,.10);
    color:var(--text-1);
  }
  ::selection{ background:var(--gold); color:var(--bg-void); }
  :focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }
  a{ color:inherit; text-decoration:none; }
  button{ font-family:var(--font-body); cursor:pointer; }
  ul{ margin:0; padding:0; list-style:none; }
  h1,h2,h3{ margin:0; font-family:var(--font-display); }
  p{ margin:0; }

  /* =========================================================
     CINEMATIC INTRO
  ========================================================= */
  #intro{ position:fixed; inset:0; z-index:200; background:#02040A; overflow:hidden; }
  #intro.hide{ opacity:0; transition:opacity .6s ease; pointer-events:none; }

  @keyframes fadeIn{ to{ opacity:1; } }
  @keyframes riseIn{ to{ opacity:1; transform:translateY(0);} }

  /* ---------- loading screen ---------- */
  #loadingScreen{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
    background:radial-gradient(ellipse at 50% 40%, #0D1526 0%, #030509 75%);
    transition:opacity .6s ease; z-index:5;
  }
  #loadingScreen.hide{ opacity:0; pointer-events:none; }
  .load-word{
    font-family:var(--font-display); font-weight:800; font-size:32px; letter-spacing:2px;
    background:linear-gradient(90deg, var(--text-1), var(--gold-bright) 50%, var(--text-1));
    -webkit-background-clip:text; background-clip:text; color:transparent;
    opacity:0; animation:fadeIn .7s ease forwards .1s;
  }
  .load-sub{ font-size:10.5px; letter-spacing:1.4px; color:var(--text-3); margin-top:6px; opacity:0; animation:fadeIn .7s ease forwards .3s; }
  .boot-log{ width:320px; max-width:82vw; font-size:11px; color:var(--text-2); line-height:1.85; min-height:100px; margin-top:26px; }
  .boot-line{ opacity:0; animation:riseIn .35s ease forwards; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .boot-line .ok{ color:var(--gold-bright); font-weight:600; }
  .boot-bar-track{ width:320px; max-width:82vw; height:3px; background:rgba(255,255,255,.08); margin-top:6px; overflow:hidden; border-radius:2px; }
  .boot-bar-fill{ height:100%; width:0%; background:linear-gradient(90deg, #8A6224, var(--gold-bright), #5FE3E0); transition:width 1.9s cubic-bezier(.3,0,.2,1); }
  .boot-pct{ font-size:10px; color:var(--text-3); letter-spacing:1px; margin-top:8px; font-variant-numeric:tabular-nums; }

  /* ---------- cinematic scene ---------- */
  #cineScene{ position:absolute; inset:0; opacity:0; transition:opacity .8s ease; }
  #cineScene.show{ opacity:1; }
  #cineSvg{ position:absolute; inset:0; width:100%; height:100%; display:block; }

  .cine-overlay-text{
    position:fixed; left:50%; top:38%; transform:translate(-50%,-50%); text-align:center;
    pointer-events:none; z-index:20; opacity:0; transition:opacity 1s ease;
  }
  .cine-overlay-text.show{ opacity:1; }
  .cine-title{
    font-family:var(--font-display); font-weight:800; font-size:clamp(28px,5vw,46px); letter-spacing:2px;
    color:var(--text-1); text-shadow:0 0 30px rgba(215,174,104,.35);
  }
  .cine-tagline{ font-size:12px; letter-spacing:2px; color:var(--gold-bright); margin-top:8px; }

  .trace-line{
    position:fixed; left:50%; top:24%; transform:translate(-50%,-50%); text-align:center; z-index:20;
    font-size:clamp(13px,2vw,16px); letter-spacing:2px; color:var(--text-1); font-family:var(--font-display); font-weight:600;
    opacity:0; transition:opacity 1s ease; pointer-events:none; text-shadow:0 0 20px rgba(95,227,224,.3);
  }
  .trace-line.show{ opacity:1; }

  /* ---------- hud tags ---------- */
  .hud-tags{ position:fixed; left:50%; top:50%; width:0; height:0; z-index:22; pointer-events:none; }
  .hud-tag{
    position:absolute; font-size:9.5px; letter-spacing:1.6px; color:#8FE3E0; white-space:nowrap;
    opacity:0; transition:opacity .6s ease; display:flex; align-items:center; gap:6px;
  }
  .hud-tag.show{ opacity:.85; }
  .hud-tag::before{ content:""; width:5px; height:5px; border-radius:50%; background:#5FE3E0; box-shadow:0 0 6px #5FE3E0; flex:none; animation:blinkDot 1.8s ease-in-out infinite; }
  @keyframes blinkDot{ 0%,100%{opacity:.3;} 50%{opacity:1;} }
  .hud-anpr{ top:-150px; left:-190px; }
  .hud-fastag{ top:-150px; left:130px; }
  .hud-identity{ top:130px; left:-210px; }
  .hud-route{ top:130px; left:130px; }
  .hud-integrity{ top:-8px; left:170px; }

  /* ---------- tyre hotspot ---------- */
  .tyre-hotspot{
    position:fixed; left:50%; top:50%; width:180px; height:180px; transform:translate(-50%,-50%);
    border-radius:50%; background:transparent; border:none; padding:0; margin:0;
    pointer-events:none; z-index:25; opacity:0;
  }
  .tyre-hotspot.ready{ pointer-events:auto; cursor:pointer; }
  .tyre-hotspot:focus-visible{ outline:2px solid var(--gold); outline-offset:6px; }

  .scan-ring{
    fill:none; stroke:#5FE3E0; stroke-width:1; stroke-dasharray:3 6; opacity:0;
    transform-origin:1010px 905px; transition:opacity .6s ease;
    animation:scanSpin 10s linear infinite;
  }
  .scan-ring.show{ opacity:.55; }
  @keyframes scanSpin{ from{ transform:rotate(0deg);} to{ transform:rotate(360deg);} }
  .scan-ring.hovered{ opacity:.95; animation-duration:3.5s; }
  .rim-spin.hovered{ filter:drop-shadow(0 0 16px rgba(95,227,224,.7)); }
  #heroTyreGroup.hovered{ transform:scale(1.035); }

  #heroTyreGroup{ transform-origin:1010px 905px; transition:transform .25s ease; }
  .rim-spin{ transform-origin:1010px 905px; animation:rimIdle 9s linear infinite; transition:filter .25s ease; }
  @keyframes rimIdle{ from{ transform:rotate(0deg);} to{ transform:rotate(360deg);} }
  .rim-spin.accelerate{ animation:rimFast .8s cubic-bezier(.5,0,.85,1) forwards; }
  @keyframes rimFast{ from{ transform:rotate(0deg);} to{ transform:rotate(900deg);} }

  .tyre-hint{
    position:fixed; left:50%; top:63%; transform:translate(-50%,0); text-align:center; z-index:24;
    opacity:0; transition:opacity .7s ease; pointer-events:none;
  }
  .tyre-hint.show{ opacity:1; }
  .tyre-hint .th-main{ font-family:var(--font-display); font-weight:700; font-size:15px; letter-spacing:2px; color:var(--text-1); }
  .tyre-hint .th-sub{ font-size:9.5px; letter-spacing:1.4px; color:var(--text-3); margin-top:4px; }

  /* ---------- corner controls ---------- */
  .cine-controls{ position:fixed; top:18px; right:18px; z-index:30; display:flex; gap:8px; }
  .cine-btn{
    background:rgba(10,16,28,.55); border:1px solid rgba(255,255,255,.12); color:var(--text-2);
    font-size:10.5px; padding:7px 12px; border-radius:20px; letter-spacing:.3px;
    display:flex; align-items:center; gap:6px; transition:border-color .15s, color .15s; backdrop-filter:blur(6px);
  }
  .cine-btn:hover{ border-color:var(--gold); color:var(--text-1); }
  .cine-btn svg{ width:13px; height:13px; }

  .enter-link{
    position:fixed; left:18px; bottom:18px; z-index:30; font-size:11px; letter-spacing:.4px; color:var(--text-2);
    border:1px solid rgba(255,255,255,.12); padding:8px 14px; border-radius:20px; background:rgba(10,16,28,.55); backdrop-filter:blur(6px);
    opacity:0; transition:opacity .6s ease, border-color .15s, color .15s;
  }
  .enter-link.show{ opacity:1; }
  .enter-link:hover, .enter-link:focus-visible{ border-color:var(--gold); color:var(--text-1); }

  .intro-disclaimer{
    position:fixed; left:50%; bottom:16px; transform:translateX(-50%); z-index:30;
    font-size:9px; color:var(--text-3); max-width:520px; text-align:center; line-height:1.5;
    opacity:0; transition:opacity .8s ease;
  }
  .intro-disclaimer.show{ opacity:.8; }

  /* ---------- portal transition ---------- */
  .portal-iris{
    position:fixed; inset:0; z-index:150; pointer-events:none;
    background:radial-gradient(circle, #FFF7E0 0%, #F1D89B 14%, #5FE3E0 40%, #14304C 68%, #060A12 100%);
    clip-path:circle(0% at 50% 50%);
    transition:clip-path .75s cubic-bezier(.5,0,.2,1);
    opacity:1;
  }
  .portal-iris.expand{ clip-path:circle(145% at 50% 50%); }
  .portal-iris.fade{ transition:opacity .55s ease; opacity:0; }

  @media (max-width:640px){
    .hud-anpr{ left:-140px; } .hud-fastag{ left:90px; } .hud-identity{ left:-150px; } .hud-route{ left:90px; } .hud-integrity{ left:110px; }
    .cine-title{ font-size:26px; } .tyre-hotspot{ width:150px; height:150px; }
  }

  /* =========================================================
     APP SHELL
  ========================================================= */
  #app{ opacity:0; }
  #app.show{ opacity:1; }
  .stagger{ opacity:0; transform:translateY(10px); }
  #app.show .stagger{ animation:riseIn .55s cubic-bezier(.3,0,.2,1) forwards; }
  #app.show .s1{ animation-delay:.04s; } #app.show .s2{ animation-delay:.12s; }
  #app.show .s3{ animation-delay:.2s; } #app.show .s4{ animation-delay:.28s; }
  #app.show .s5{ animation-delay:.34s; }

  .shell{ display:flex; min-height:100vh; }

  /* ---------- sidebar ---------- */
  .sidebar{
    width:236px; flex:none; min-height:100vh; position:sticky; top:0; align-self:flex-start;
    background:var(--glass-strong); border-right:1px solid var(--border-glass);
    backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
    display:flex; flex-direction:column; padding:20px 14px;
  }
  .side-brand{ display:flex; align-items:center; gap:10px; padding:4px 8px 22px; }
  .side-brand svg{ width:30px; height:30px; flex:none; }
  .side-brand-name{ font-family:var(--font-display); font-weight:700; font-size:15.5px; letter-spacing:.2px; }
  .side-brand-tag{ font-size:8.5px; color:var(--text-3); letter-spacing:.5px; margin-top:1px; }

  .nav-list{ display:flex; flex-direction:column; gap:2px; flex:1; }
  .nav-item{
    display:flex; align-items:center; gap:11px; padding:9px 12px; border-radius:8px;
    font-size:13px; color:var(--text-2); border:1px solid transparent;
    transition:background .15s, color .15s;
  }
  .nav-item svg{ width:17px; height:17px; flex:none; opacity:.85; }
  .nav-item:hover{ background:rgba(15,23,42,.045); color:var(--text-1); }
  .nav-item.active{ background:var(--gold-dim); color:var(--gold-bright); border-color:rgba(30,64,175,.25); }

  .side-foot{ padding:12px 10px 4px; border-top:1px solid var(--border-glass-2); margin-top:8px; }
  .side-foot-label{ font-size:9px; letter-spacing:.5px; color:var(--text-3); line-height:1.6; }

  /* ---------- main / topbar ---------- */
  .main{ flex:1; min-width:0; display:flex; flex-direction:column; }
  .topbar{
    position:sticky; top:0; z-index:20; background:var(--glass-strong); border-bottom:1px solid var(--border-glass);
    backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
    padding:14px 26px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;
  }
  .topbar-titles{ display:flex; flex-direction:column; line-height:1.3; }
  .topbar-eyebrow{ font-size:9.5px; letter-spacing:1px; color:var(--text-3); }
  .topbar-title{ font-family:var(--font-display); font-weight:700; font-size:16.5px; }
  .topbar-right{ margin-left:auto; display:flex; align-items:center; gap:18px; font-size:11.5px; color:var(--text-2); position:relative; }
  .topbar-clock{ color:var(--text-1); }
  .topbar-engine{ color:var(--text-3); }
  .profile-chip{ display:flex; align-items:center; gap:9px; padding:5px 10px 5px 5px; border-radius:20px; background:rgba(15,23,42,.04); border:1px solid var(--border-glass); }
  .profile-avatar{ width:26px; height:26px; border-radius:50%; background:linear-gradient(135deg, var(--gold), #142B82); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:#FFFFFF; }
  .profile-text{ line-height:1.25; }
  .profile-name{ font-size:12px; color:var(--text-1); font-weight:600; }
  .profile-role{ font-size:9.5px; color:var(--text-3); }

  .profile-chip{ cursor:pointer; position:relative; user-select:none; }
  .profile-chip:hover{ border-color:rgba(215,174,104,.35); background:rgba(215,174,104,.07); }
  .profile-chip:focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }
  .profile-menu{
    position:absolute; right:0; top:calc(100% + 10px); width:280px; padding:14px;
    background:rgba(255,255,255,.985); border:1px solid var(--border-glass); border-radius:14px;
    box-shadow:0 18px 50px rgba(15,23,42,.16); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
    opacity:0; transform:translate3d(0,-6px,0) scale(.98); transform-origin:top right;
    pointer-events:none; transition:opacity .18s ease, transform .18s ease; z-index:60;
  }
  .profile-menu.open{ opacity:1; transform:translate3d(0,0,0) scale(1); pointer-events:auto; }
  .profile-menu-head{ display:flex; align-items:center; gap:11px; padding-bottom:12px; border-bottom:1px solid var(--border-glass-2); }
  .profile-menu-avatar{ width:38px; height:38px; border-radius:50%; background:linear-gradient(135deg,var(--gold),#1E40AF); display:flex; align-items:center; justify-content:center; font-weight:800; color:#FFFFFF; }
  .profile-menu-name{ font-size:13px; font-weight:700; }
  .profile-menu-sub{ font-size:10px; color:var(--text-3); margin-top:2px; }
  .profile-menu-meta{ margin:12px 0; display:grid; gap:6px; }
  .profile-meta-row{ display:flex; justify-content:space-between; gap:12px; font-size:11px; }
  .profile-meta-row span:first-child{ color:var(--text-3); }
  .profile-meta-row span:last-child{ color:var(--text-1); font-weight:600; }
  .profile-menu-actions{ display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .profile-action{ padding:9px 10px; border-radius:9px; background:rgba(15,23,42,.025); border:1px solid var(--border-glass); color:var(--text-1); font-size:11px; font-weight:600; cursor:pointer; }
  .profile-action:hover{ background:var(--gold-dim); border-color:rgba(215,174,104,.35); }


  .content{ padding:24px 26px 50px; max-width:1360px; width:100%; margin:0 auto; }

  /* ---------- welcome ---------- */
  .welcome h1{ font-size:23px; font-weight:700; }
  .welcome p{ margin-top:6px; font-size:13px; color:var(--text-2); max-width:640px; line-height:1.6; }
  .sim-tag{
    display:inline-flex; align-items:center; gap:6px; margin-top:12px; padding:5px 11px; border-radius:20px;
    background:var(--blue-dim); border:1px solid rgba(76,144,255,.25); font-size:10.5px; color:#AFC9FF; letter-spacing:.3px;
  }
  .sim-tag .dot{ width:5px; height:5px; border-radius:50%; background:var(--blue); }

  /* ---------- kpi grid ---------- */
  .kpi-grid{ margin-top:20px; display:grid; grid-template-columns:repeat(6,1fr); gap:12px; }
  .kpi-card{
    background:var(--glass); border:1px solid var(--border-glass); border-radius:14px; padding:15px;
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    transition:border-color .15s, transform .15s;
  }
  .kpi-card:hover{ border-color:rgba(15,23,42,.18); transform:translateY(-2px); }
  .kpi-icon{ width:32px; height:32px; border-radius:9px; display:flex; align-items:center; justify-content:center; margin-bottom:10px; }
  .kpi-icon svg{ width:16px; height:16px; }
  .kpi-value{ font-family:var(--font-display); font-size:22px; font-weight:700; }
  .kpi-label{ font-size:10.5px; color:var(--text-2); margin-top:3px; letter-spacing:.1px; }
  .kpi-delta{ font-size:10px; margin-top:7px; display:inline-flex; }

  .tone-blue .kpi-icon{ background:var(--blue-dim); color:var(--blue); }
  .tone-green .kpi-icon{ background:var(--green-dim); color:var(--green); }
  .tone-amber .kpi-icon{ background:var(--amber-dim); color:var(--amber); }
  .tone-red .kpi-icon{ background:var(--red-dim); color:var(--red); }
  .tone-purple .kpi-icon{ background:var(--purple-dim); color:var(--purple); }
  .tone-gold .kpi-icon{ background:var(--gold-dim); color:var(--gold-bright); }
  .tone-blue .kpi-delta{ color:var(--blue); } .tone-green .kpi-delta{ color:var(--green); }
  .tone-amber .kpi-delta{ color:var(--amber); } .tone-red .kpi-delta{ color:var(--red); }
  .tone-purple .kpi-delta{ color:var(--purple); } .tone-gold .kpi-delta{ color:var(--gold-bright); }

  /* ---------- panel base ---------- */
  .panel{
    background:var(--glass); border:1px solid var(--border-glass); border-radius:14px;
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); overflow:hidden;
  }
  .panel-head{ padding:14px 16px; border-bottom:1px solid var(--border-glass-2); display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
  .panel-title{ font-family:var(--font-display); font-size:14.5px; font-weight:700; }
  .panel-caption{ font-size:10px; color:var(--text-3); margin-top:2px; }
  .panel-link{ font-size:11px; color:var(--gold); display:flex; align-items:center; gap:3px; flex:none; }
  .panel-link svg{ width:12px; height:12px; }
  .panel-body{ padding:16px; }

  /* ---------- charts row ---------- */
  .charts-row{ margin-top:14px; display:grid; grid-template-columns:1.6fr 1fr; gap:14px; }
  .legend{ display:flex; flex-direction:column; gap:8px; margin-top:4px; }
  .legend-row{ display:flex; align-items:center; gap:8px; font-size:11.5px; color:var(--text-2); }
  .legend-dot{ width:8px; height:8px; border-radius:2px; flex:none; }
  .legend-row .lv{ margin-left:auto; color:var(--text-1); font-weight:600; }
  .donut-wrap{ display:flex; align-items:center; gap:18px; }
  .donut-center{ text-align:center; }
  .donut-center .dv{ font-family:var(--font-display); font-size:20px; font-weight:700; }
  .donut-center .dl{ font-size:9px; color:var(--text-3); margin-top:2px; }

  /* ---------- hotspot ---------- */
  .hotspot-grid{ display:flex; flex-direction:column; gap:11px; }
  .hotspot-row{ display:flex; align-items:center; gap:12px; }
  .hotspot-city{ width:92px; flex:none; font-size:12px; color:var(--text-1); }
  .hotspot-bar-track{ flex:1; height:7px; border-radius:4px; background:rgba(15,23,42,.07); overflow:hidden; }
  .hotspot-bar-fill{ height:100%; border-radius:4px; }
  .hotspot-count{ width:52px; flex:none; text-align:right; font-size:11.5px; color:var(--text-2); }
  .tier-pill{ width:76px; flex:none; text-align:center; font-size:9px; letter-spacing:.3px; padding:2.5px 0; border-radius:20px; font-weight:600; }

  /* ---------- bottom row ---------- */
  .bottom-row{ margin-top:14px; display:grid; grid-template-columns:1.5fr 1fr 1fr; gap:14px; align-items:start; }

  table{ width:100%; border-collapse:collapse; font-size:12px; }
  th{ text-align:left; font-size:10px; letter-spacing:.3px; color:var(--text-3); font-weight:600; padding:0 16px 10px; }
  td{ padding:11px 16px; border-top:1px solid var(--border-glass-2); vertical-align:middle; }
  tbody tr{ cursor:pointer; transition:background .12s; }
  tbody tr:hover{ background:rgba(15,23,42,.03); }
