<script>
(function(){
  const API = window.location.origin;
  const LIVE_REFRESH_MS = 15000;

  async function api(path, options={}){
    const res = await fetch(API + path, {
      headers: {"Content-Type":"application/json", ...(options.headers||{})},
      ...options
    });
    let data = null;
    try { data = await res.json(); } catch (_) {}
    if(!res.ok) throw new Error(data?.detail ? JSON.stringify(data.detail) : `HTTP ${res.status}`);
    return data;
  }

  function esc(v){
    return String(v ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  }
  function tierClass(t){
    return String(t||'low').toLowerCase();
  }
  function fmt(n){
    const x=Number(n||0);
    return x.toLocaleString('en-IN');
  }
  function fmtTime(v){
    if(!v) return '—';
    const d=new Date(v);
    return Number.isNaN(d.getTime()) ? String(v) : d.toLocaleString('en-GB',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'short'});
  }

  function ensureLiveBadge(){
    if(document.getElementById('trustrakLiveBadge')) return;
    const b=document.createElement('div');
    b.id='trustrakLiveBadge';
    b.textContent='LOCAL API · CONNECTING';
    Object.assign(b.style,{position:'fixed',right:'18px',bottom:'16px',zIndex:'99999',padding:'7px 10px',borderRadius:'999px',font:'600 10px Inter,sans-serif',letterSpacing:'.04em',background:'#eef2f7',color:'#54637c',border:'1px solid rgba(15,23,42,.10)',boxShadow:'0 4px 18px rgba(15,23,42,.08)'});
    document.body.appendChild(b);
  }
  function setLiveBadge(ok,msg='LOCAL API · LIVE'){
    ensureLiveBadge();
    const b=document.getElementById('trustrakLiveBadge');
    b.textContent=msg;
    b.style.color=ok?'#178A50':'#D33A3A';
    b.style.background=ok?'rgba(23,138,80,.10)':'rgba(211,58,58,.10)';
    b.style.borderColor=ok?'rgba(23,138,80,.22)':'rgba(211,58,58,.22)';
  }

  async function loadSummary(){
    const s=await api('/api/reports/summary');
    const t=s.totals||{};
    const r=s.risk_distribution||{};
    const st=s.verification_status||{};
    const kpi=document.getElementById('kpiGrid');
    if(kpi){
      const vals=[
        ['Total Vehicles Monitored',t.vehicles,'blue'],
        ['ANPR Events',t.anpr_events,'green'],
        ['Verification Cases',t.verification_cases,'amber'],
        ['Movement Events',t.movement_events,'purple'],
        ['FASTag Events',t.fastag_events,'red'],
        ['Open Verification Cases',t.open_verification_cases,'gold']
      ];
      kpi.innerHTML=vals.map(([label,val,tone])=>`<div class="kpi-card tone-${tone}"><div class="kpi-icon"><span style="font-size:15px;font-weight:800">●</span></div><div class="kpi-value" data-live-kpi="1">${fmt(val)}</div><div class="kpi-label">${esc(label)}</div><div class="kpi-delta">Live from local FastAPI backend</div></div>`).join('');
    }
    const pending=document.getElementById('kpiPending');
    if(pending) pending.textContent=fmt(t.open_verification_cases);

    const title=document.querySelector('#view-dashboard .sim-tag');
    if(title) title.innerHTML='<span class="dot"></span>Local FastAPI + SQLite backend connected · synthetic academic data';

    return {s,r,st};
  }

  function caseRows(cases){
    return (cases||[]).map((c,i)=>{
      const tier=tierClass(c.risk_tier);
      const reason=(c.reasons||'').split(' | ')[0] || 'Verification signal';
      return `<tr data-live-case="${esc(c.case_id)}" data-live-plate="${esc(c.registration_number)}">
        <td class="rank-badge">${esc(c.rank ?? (i+1))}</td>
        <td class="plate-cell">${esc(c.registration_number)}</td>
        <td><span class="risk-chip ${tier}">${esc(c.risk_score)}</span></td>
        <td>${esc(reason)}</td>
        <td>See latest ANPR</td>
        <td><span class="status-pill ${tier}">${esc(c.status||'VERIFY')}</span></td>
      </tr>`;
    }).join('');
  }

  function attachCaseRowHandlers(){
    document.querySelectorAll('[data-live-case]').forEach(row=>{
      if(row.dataset.liveBound) return;
      row.dataset.liveBound='1';
      row.addEventListener('click',()=>openLiveCase(row.dataset.liveCase,row.dataset.livePlate));
    });
  }

  async function loadCases(){
    const data=await api('/api/risk/cases?limit=100');
    const top=(data.cases||[]).slice(0,10);
    const body=document.getElementById('casesTableBody');
    if(body){ body.innerHTML=caseRows(top); attachCaseRowHandlers(); }
    const full=document.getElementById('casesFullTableBody');
    if(full){ full.innerHTML=caseRows(data.cases||[]); attachCaseRowHandlers(); }
    return data;
  }

  async function loadAudit(){
    const data=await api('/api/audit/logs?limit=100');
    const tbody=document.getElementById('auditTableBody');
    if(!tbody) return;
    if(!data.logs?.length){
      tbody.innerHTML='<tr><td colspan="6" style="text-align:center;color:var(--text-3);padding:24px">No audit events recorded yet.</td></tr>';
      return;
    }
    tbody.innerHTML=data.logs.map(l=>`<tr>
      <td>${esc(l.case_id||'—')}</td>
      <td class="plate-cell">${esc(l.registration_number||'—')}</td>
      <td>Duty Analyst</td>
      <td>${esc(l.new_status||l.action||'—')}</td>
      <td>${esc(l.details||'—')}</td>
      <td>${esc(fmtTime(l.timestamp))}</td>
    </tr>`).join('');
  }

  async function loadAnpr(){
    const data=await api('/api/anpr/events?limit=50');
    const events=data.events||[];
    const hist=document.getElementById('anprEventHistory');
    if(hist){
      const html=events.map(e=>`<div class="event-row"><span><b>${esc(e.registration_number)}</b> · ${esc(e.location)}</span><span>${esc(fmtTime(e.timestamp))}</span></div>`).join('');
      if(html) hist.innerHTML=html;
    }
    return data;
  }

  async function loadReportPage(){
    const s=await api('/api/reports/summary');
    let panel=document.getElementById('liveBackendSummary');
    if(!panel){
      const root=document.querySelector('#view-reports .panel');
      if(root){
        panel=document.createElement('div');
        panel.id='liveBackendSummary';
        panel.className='panel';
        panel.style.marginTop='14px';
        root.parentElement.insertBefore(panel,root.nextSibling);
      }
    }
    if(panel){
      const t=s.totals||{},a=s.anomalies||{},r=s.risk_distribution||{};
      panel.innerHTML=`<div class="panel-head"><div><div class="panel-title">Live backend summary</div><div class="panel-caption">Current counts from FastAPI + SQLite</div></div></div>
      <div class="panel-body" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px">
        ${[['Vehicles',t.vehicles],['ANPR',t.anpr_events],['FASTag',t.fastag_events],['Movement',t.movement_events],['Open cases',t.open_verification_cases],['Unknown registry',a.unknown_registry_events]].map(x=>`<div class="detect-field"><span class="dl">${x[0]}</span><span class="dv">${fmt(x[1])}</span></div>`).join('')}
        <div class="detect-field"><span class="dl">Critical / High</span><span class="dv">${fmt(r.CRITICAL||0)} / ${fmt(r.HIGH||0)}</span></div>
      </div>`;
    }
  }

  window.TRUSTRAK_API = {
    get: (path, options={}) => api(path, options),
    recordAnpr: (payload) => api('/api/anpr/events',{
      method:'POST',
      body:JSON.stringify(payload)
    })
  };

  function showOnlyView(id){
    document.querySelectorAll('[id^="view-"]').forEach(s=>s.style.display='none');
    const target=document.getElementById('view-'+id);
    if(target) target.style.display='block';
  }

  async function openLiveCase(caseId,plate){
    try{
      const [c,risk,anpr]=await Promise.all([
        api('/api/risk/cases/'+encodeURIComponent(plate)),
        api('/api/risk/live/'+encodeURIComponent(plate)),
        api('/api/anpr/events?limit=100')
      ]);
      const events=(anpr.events||[]).filter(e=>e.registration_number===plate).slice(0,10);
      const reasons=String(c.reasons||'').split(' | ').filter(Boolean);
      const evidence=String(c.evidence||'').split(' | ').filter(Boolean);
      const box=document.getElementById('caseDetailContent');
      if(box){
        box.innerHTML=`<div class="case-detail-grid">
          <div class="panel" style="padding:18px"><div class="modal-section-title">Verification case</div>
            <div class="detect-field"><span class="dl">Case</span><span class="dv">${esc(c.case_id)}</span></div>
            <div class="detect-field"><span class="dl">Vehicle</span><span class="dv">${esc(c.registration_number)}</span></div>
            <div class="detect-field"><span class="dl">Risk</span><span class="dv">${esc(c.risk_score)} · ${esc(c.risk_tier)}</span></div>
            <div class="detect-field"><span class="dl">Status</span><span class="dv" id="liveCaseStatus">${esc(c.status)}</span></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px" id="liveCaseActions"></div>
            <div class="modal-section-title" style="margin-top:18px">Reasons</div>
            <div class="reason-list">${reasons.map(x=>`<div class="reason-row"><span>${esc(x)}</span></div>`).join('')||'<div class="reason-row"><span>No recorded reason</span></div>'}</div>
            <div class="modal-section-title" style="margin-top:18px">Evidence</div>
            <div class="reason-list">${evidence.map(x=>`<div class="reason-row"><span>${esc(x)}</span></div>`).join('')||'<div class="reason-row"><span>No explicit evidence reference</span></div>'}</div>
          </div>
          <div class="panel" style="padding:18px"><div class="modal-section-title">Live vehicle analysis</div>
            <div class="detect-field"><span class="dl">Registry</span><span class="dv">${risk.registry_match?'MATCH':'NO MATCH'}</span></div>
            <div class="detect-field"><span class="dl">Movement</span><span class="dv">${esc(risk.movement?.status||'—')}</span></div>
            <div class="detect-field"><span class="dl">Distance</span><span class="dv">${esc(risk.movement?.distance_km ?? '—')} km</span></div>
            <div class="detect-field"><span class="dl">Implied speed</span><span class="dv">${esc(risk.movement?.implied_speed_kmh ?? '—')} km/h</span></div>
            <div class="detect-field"><span class="dl">FASTag</span><span class="dv">${risk.fastag ? esc(risk.fastag.transaction_id)+' · '+esc(risk.fastag.time_difference_minutes)+' min' : 'No valid temporal match'}</span></div>
            <div class="modal-section-title" style="margin-top:18px">Recent ANPR sightings</div>
            <div>${events.map(e=>`<div class="sight-row"><span class="sight-cam">${esc(e.camera_id)}</span><span class="sight-loc">${esc(e.location)}</span><span class="sight-time">${esc(fmtTime(e.timestamp))}</span><span class="sight-conf">${(Number(e.ocr_confidence||0)*100).toFixed(1)}%</span></div>`).join('')||'<div class="scan-note">No recent sightings.</div>'}</div>
          </div>
        </div>`;
        showOnlyView('case-detail');
        const back=document.getElementById('backToCases');
        if(back){ back.onclick=()=>showOnlyView('cases'); }
        const actions=document.getElementById('liveCaseActions');
        if(actions){
          const status=String(c.status||'VERIFY').toUpperCase();
          const next={
            VERIFY:['UNDER_REVIEW'],
            UNDER_REVIEW:['VERIFIED','FALSE_POSITIVE'],
            VERIFIED:['CLOSED'],
            FALSE_POSITIVE:['CLOSED'],
            CLOSED:[]
          }[status] || [];
          actions.innerHTML=next.map(s=>`<button class="qa-btn live-status-btn" data-status="${s}" style="width:auto">${s.replace('_',' ')}</button>`).join('');
          actions.querySelectorAll('.live-status-btn').forEach(btn=>btn.addEventListener('click',async()=>{
            try{
              const result=await api('/api/risk/cases/'+encodeURIComponent(caseId),{method:'PATCH',body:JSON.stringify({status:btn.dataset.status})});
              const ns=result.case.status;
              const st=document.getElementById('liveCaseStatus'); if(st) st.textContent=ns;
              await Promise.all([loadSummary(),loadCases(),loadAudit()]);
              toast('Case '+caseId+' updated — '+ns);
              await openLiveCase(caseId,plate);
            }catch(err){ alert('Status update failed: '+err.message); }
          }));
        }
      }
      setLiveBadge(true);
    }catch(e){
      setLiveBadge(false,'LOCAL API · ERROR');
      console.error(e);
      alert('Unable to load live case: '+e.message);
    }
  }

  async function liveSearch(plate){
    plate=String(plate||'').trim().toUpperCase();
    if(!plate) return;
    const c=document.getElementById('vsContent');
    if(!c) return;
    try{
      const [v,risk,anpr]=await Promise.all([
        window.TRUSTRAK_API.get('/api/vehicles/'+encodeURIComponent(plate)),
        api('/api/risk/live/'+encodeURIComponent(plate)).catch(e=>null),
        api('/api/anpr/events?limit=500')
      ]);
      const events=(anpr.events||[]).filter(e=>e.registration_number===plate).slice(0,10);
      c.innerHTML=`<div class="case-detail-grid">
        <div class="panel" style="padding:18px"><div class="modal-section-title">Vehicle identity</div>
          ${[['Registration',v.registration_number],['Vehicle ID',v.vehicle_id],['Type',v.vehicle_type],['Manufacturer',v.manufacturer],['Model',v.model],['Colour',v.registered_colour],['Operator',v.operator],['Permit',v.permit_status],['Fitness',v.fitness_status],['FASTag',v.fastag_id],['FASTag status',v.fastag_status]].map(x=>`<div class="detect-field"><span class="dl">${esc(x[0])}</span><span class="dv">${esc(x[1] ?? '—')}</span></div>`).join('')}
        </div>
        <div class="panel" style="padding:18px"><div class="modal-section-title">Live risk & movement</div>
          <div class="detect-field"><span class="dl">Risk</span><span class="dv">${risk?esc(risk.risk_score)+' · '+esc(risk.risk_tier):'—'}</span></div>
          <div class="detect-field"><span class="dl">Status</span><span class="dv">${risk?esc(risk.status):'—'}</span></div>
          <div class="detect-field"><span class="dl">Movement</span><span class="dv">${risk?esc(risk.movement?.status||'—'):'—'}</span></div>
          <div class="detect-field"><span class="dl">Implied speed</span><span class="dv">${risk?esc(risk.movement?.implied_speed_kmh ?? '—')+' km/h':'—'}</span></div>
          <div class="modal-section-title" style="margin-top:18px">Recent ANPR</div>
          ${events.map(e=>`<div class="sight-row"><span class="sight-cam">${esc(e.camera_id)}</span><span class="sight-loc">${esc(e.location)}</span><span class="sight-time">${esc(fmtTime(e.timestamp))}</span><span class="sight-conf">${(Number(e.ocr_confidence||0)*100).toFixed(1)}%</span></div>`).join('')||'<div class="scan-note">No ANPR events found.</div>'}
        </div>
      </div>`;
      setLiveBadge(true);
    }catch(e){
      c.innerHTML=`<div class="panel placeholder-panel"><p>No live registry match for <b>${esc(plate)}</b>.</p></div>`;
      setLiveBadge(true);
    }
  }

  function bindSearch(){
    const input=document.getElementById('vsInput');
    if(!input || input.dataset.liveBound) return;
    input.dataset.liveBound='1';
    input.addEventListener('keydown',e=>{
      if(e.key==='Enter') liveSearch(input.value);
    });
    const box=input.closest('.search-box');
    if(box && !box.querySelector('.live-search-btn')){
      const btn=document.createElement('button');
      btn.className='live-search-btn';
      btn.textContent='Search';
      Object.assign(btn.style,{border:'1px solid rgba(15,23,42,.10)',background:'#fff',borderRadius:'7px',padding:'7px 10px',font:'600 11px Inter,sans-serif',cursor:'pointer',color:'#54637c'});
      btn.addEventListener('click',()=>liveSearch(input.value));
      box.appendChild(btn);
    }
  }

  async function refreshAll(){
    try{
      await Promise.all([loadSummary(),loadCases()]);
      bindSearch();
      setLiveBadge(true);
    }catch(e){
      setLiveBadge(false,'LOCAL API · OFFLINE');
      console.warn('TRUSTRAK live refresh failed:',e);
    }
  }

  async function onNav(){
    setTimeout(async()=>{
      try{
        await refreshAll();
        await loadAudit();
        await loadReportPage();
      }catch(e){console.warn(e)}
    },120);
  }

  ensureLiveBadge();
  refreshAll();
  setInterval(refreshAll,LIVE_REFRESH_MS);
  document.getElementById('navList')?.addEventListener('click',onNav);
  window.addEventListener('focus',refreshAll);
})();
</script>

</body>
</html>
