  .id-card .idf .fl{ font-size:9.5px; color:var(--text-3); letter-spacing:.3px; }
  .id-card .idf .fv{ font-size:14px; color:var(--text-1); margin-top:3px; font-weight:600; }

  .mini-graph-wrap{ display:flex; justify-content:center; padding:10px 0; }

  .case-detail-grid{ display:grid; grid-template-columns:1.3fr 1fr; gap:14px; margin-top:14px; align-items:start; }
  .cd-plate{ font-family:var(--font-display); font-size:26px; font-weight:700; }
  .cd-caseid{ font-size:10.5px; color:var(--text-3); letter-spacing:.4px; }

  /* ---------- live TN map ---------- */
  #tnMap{ background:radial-gradient(ellipse at 40% 30%, rgba(76,144,255,.05), transparent 65%); border-radius:10px; }
  .tn-outline{ fill:rgba(15,23,42,.035); stroke:rgba(15,23,42,.22); stroke-width:1.4; }
  .tn-city-dot{ }
  .tn-city-label{ font-size:8.5px; fill:var(--text-2); font-family:'Inter',sans-serif; }
  .tn-vehicle{ filter:drop-shadow(0 0 4px currentColor); }
  .map-move-row{ display:flex; align-items:center; gap:8px; font-size:11px; color:var(--text-2); }
  .map-move-row .mdot{ width:7px; height:7px; border-radius:50%; flex:none; }
  .map-move-row b{ color:var(--text-1); }

  /* ---------- live ANPR ---------- */
  .anpr-grid{ display:grid; grid-template-columns:1.5fr 1fr; gap:14px; margin-top:16px; }
  .cam-tiles{ display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:12px; align-content:start; }
  .cam-tile{ transition:box-shadow .15s ease; }
  .cam-tile.cam-flash{ animation:camFlash .7s ease; }
  @keyframes camFlash{ 0%{ box-shadow:0 0 0 2px var(--gold-bright) inset; } 100%{ box-shadow:0 0 0 0 transparent inset; } }
  .live-blip{ width:6px; height:6px; border-radius:50%; background:var(--red); flex:none; animation:blinkDot 1.6s ease-in-out infinite; }
  .cam-feed{ position:relative; background:#060A12; border-radius:0; overflow:hidden; aspect-ratio:16/10; }
  .cam-scan{
    position:absolute; left:0; right:0; top:0; height:2px;
    background:linear-gradient(90deg, transparent, rgba(95,227,224,.85), transparent);
    animation:scanMove 3.2s linear infinite;
  }
  @keyframes scanMove{ from{ top:0%; } to{ top:100%; } }
  .cam-bbox{ fill:none; stroke:#5FE3E0; stroke-width:1.4; stroke-dasharray:4 3; opacity:.8; }
  .cam-time{ position:absolute; right:6px; bottom:5px; font-size:8.5px; color:var(--text-3); font-family:'Inter',monospace; }
  .cam-plate-chip{
    display:inline-block; background:#EDEFF2; color:#101317; font-family:'Inter',monospace; font-weight:700;
    padding:3px 9px; border-radius:4px; font-size:12px; letter-spacing:.6px;
  }
  .detect-field{ padding:9px 0; border-top:1px solid var(--border-glass-2); display:flex; justify-content:space-between; gap:10px; font-size:12.5px; }
  .detect-field:first-child{ border-top:none; }
  .detect-field .dl{ color:var(--text-3); }
  .detect-field .dv{ color:var(--text-1); font-family:'Inter',monospace; font-weight:600; text-align:right; }
  .anomaly-callout{
    margin-top:10px; padding:10px 12px; border-radius:8px; background:rgba(239,93,93,.1);
    border:1px solid rgba(239,93,93,.28); font-size:11.5px; color:var(--text-1); line-height:1.5;
  }
  .anomaly-callout b{ color:var(--red); }
  .log-row{ display:flex; justify-content:space-between; gap:8px; padding:8px 16px; font-size:11px; border-top:1px solid var(--border-glass-2); color:var(--text-2); }
  .log-row:first-child{ border-top:none; }
  .log-row b{ color:var(--text-1); }
  .log-row.flag{ background:rgba(239,93,93,.07); }
  @media (max-width:900px){ .anpr-grid{ grid-template-columns:1fr; } }

  /* ---------- shared camera controls / physical input ---------- */
  .physical-anpr{ margin-top:14px; }
  .physical-anpr-head{ display:flex; align-items:flex-start; justify-content:space-between; gap:14px; flex-wrap:wrap; }
  .physical-anpr-head p{ margin-top:5px; font-size:11.5px; color:var(--text-2); line-height:1.5; max-width:760px; }
  .cam-controls{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .cam-btn{
    appearance:none; border:1px solid var(--border-glass); background:var(--glass); color:var(--text-1);
    min-height:36px; padding:8px 13px; border-radius:9px; font:600 11px var(--font-body);
    line-height:1; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center;
    transition:transform .15s ease, border-color .15s ease, background .15s ease, box-shadow .15s ease, color .15s ease;
  }
  .cam-btn:hover{ border-color:rgba(30,64,175,.30); background:rgba(30,64,175,.055); box-shadow:0 4px 14px rgba(15,23,42,.06); transform:translateY(-1px); }
  .cam-btn:active{ transform:translateY(0); box-shadow:none; }
  .cam-btn:disabled{ opacity:.55; cursor:not-allowed; transform:none; box-shadow:none; }
  .cam-btn.stop{ color:var(--red); border-color:rgba(211,58,58,.24); background:rgba(211,58,58,.035); }
  .cam-btn.stop:hover{ background:var(--red-dim); border-color:rgba(211,58,58,.32); }
  .webcam-stage{
    margin-top:13px; display:grid; grid-template-columns:minmax(0,1.55fr) minmax(240px,.72fr);
    gap:14px; align-items:stretch;
  }
  .webcam-wrap{
    position:relative; width:100%; aspect-ratio:16/9; min-height:320px;
    background:#02050A; border:1px solid rgba(15,23,42,.14); border-radius:12px; overflow:hidden;
    box-shadow:0 12px 28px rgba(2,5,10,.10); isolation:isolate;
  }
  .webcam-wrap::after{
    content:""; position:absolute; inset:0; pointer-events:none; z-index:1;
    background:linear-gradient(180deg,rgba(0,0,0,.05),transparent 20%,transparent 78%,rgba(0,0,0,.20));
  }
  #physicalVideo{ width:100%; height:100%; display:block; object-fit:cover; background:#02050A; transform:scaleX(-1); }
  .cam-status{
    position:absolute; left:10px; top:10px; z-index:6; display:inline-flex; align-items:center; gap:6px;
    min-height:25px; padding:5px 9px; font:600 9px var(--font-body); letter-spacing:.2px;
    border-radius:20px; background:rgba(3,6,12,.72); color:#B8C4D6; border:1px solid rgba(255,255,255,.12);
    backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
  }
  .cam-status::before{ content:""; width:5px; height:5px; border-radius:50%; background:#94A3B8; flex:none; }
  .cam-status.live{ color:#73E0A5; border-color:rgba(115,224,165,.24); }
  .cam-status.live::before{ background:#73E0A5; box-shadow:0 0 0 4px rgba(115,224,165,.10); }
  .capture-row{ display:flex; align-items:center; gap:8px; margin-top:10px; flex-wrap:wrap; }
  .capture-row .cam-btn{ flex:0 0 auto; min-width:142px; }
  .scan-note{ margin-top:8px; padding:0 2px; color:var(--text-3); font-size:9.5px; line-height:1.55; }

  /* ---------- single-camera physical ANPR gate monitor ---------- */
  .anpr-welcome{ display:flex; align-items:flex-start; justify-content:space-between; gap:18px; flex-wrap:wrap; }
  .anpr-eyebrow{ display:flex; align-items:center; gap:8px; margin-bottom:7px; font-size:9px; letter-spacing:1.4px; font-weight:700; color:var(--text-3); }
  .anpr-live-dot{ width:7px; height:7px; border-radius:50%; background:var(--green); box-shadow:0 0 0 4px rgba(23,138,80,.08); animation:blinkDot 1.6s ease-in-out infinite; }
