  function clearJourneyDisplay(){
    ['journeyPrevGate','journeyPrevTime','journeyPrevCamera','journeyNextGate','journeyNextTime','journeyNextCamera','journeyDistance','journeyElapsed','journeySpeed','journeyMinTime'].forEach(id=>{ const el=document.getElementById(id); if(el) el.textContent='—'; });
    const result=document.getElementById('journeyResult');
    result.className='journey-result neutral';
    document.getElementById('journeyResultTitle').textContent='Waiting for two different-gate events';
    document.getElementById('journeyResultText').textContent='A single sighting is recorded but not classified as a cloned-identity event. Cross-gate comparison begins only when two gate observations for the same registration exist.';
  }

  function renderJourneyAnalysis(){
    const normalized=document.getElementById('journeyVehicleSelect')?.value;
    if(!normalized){ clearJourneyDisplay(); return; }
    const events=anprEvents.filter(e=>e.normalizedPlate===normalized).slice().sort((a,b)=>new Date(a.timestamp)-new Date(b.timestamp));
    let pair=null;
    for(let i=events.length-1;i>0;i--){
      if(events[i].gate!==events[i-1].gate){ pair=[events[i-1],events[i]]; break; }
    }
    if(!pair){
      if(events.length){
        const e=events[events.length-1];
        document.getElementById('journeyPrevGate').textContent=e.gate;
        document.getElementById('journeyPrevTime').textContent=safeDateTime(e.timestamp);
        document.getElementById('journeyPrevCamera').textContent=e.cameraId;
      }
      clearJourneyDisplay();
      return;
    }
    const [prev,next]=pair;
    document.getElementById('journeyPrevGate').textContent=prev.gate;
    document.getElementById('journeyPrevTime').textContent=safeDateTime(prev.timestamp);
    document.getElementById('journeyPrevCamera').textContent=prev.cameraId;
    document.getElementById('journeyNextGate').textContent=next.gate;
    document.getElementById('journeyNextTime').textContent=safeDateTime(next.timestamp);
    document.getElementById('journeyNextCamera').textContent=next.cameraId;

    const distance=graph.shortest(prev.gate,next.gate);
    const elapsedMinutes=(new Date(next.timestamp)-new Date(prev.timestamp))/60000;
    if(distance==null || !Number.isFinite(elapsedMinutes) || elapsedMinutes<=0){
      document.getElementById('journeyDistance').textContent=distance!=null?distance+' km':'Unknown';
      document.getElementById('journeyElapsed').textContent=Number.isFinite(elapsedMinutes)?formatDurationMinutes(elapsedMinutes):'—';
      document.getElementById('journeySpeed').textContent='—';
      document.getElementById('journeyMinTime').textContent='—';
      const result=document.getElementById('journeyResult'); result.className='journey-result warning';
      document.getElementById('journeyResultTitle').textContent='ROUTE DATA REQUIRES VERIFICATION';
      document.getElementById('journeyResultText').textContent='The gate pair cannot be evaluated with the current route graph or timestamps.';
      return;
    }
    const speed=distance/(elapsedMinutes/60);
    const minHours=distance/105;
    const implausible=speed>105;
    document.getElementById('journeyDistance').textContent=distance+' km';
    document.getElementById('journeyElapsed').textContent=formatDurationMinutes(elapsedMinutes);
    document.getElementById('journeySpeed').textContent=(Math.round(speed*10)/10).toLocaleString('en-IN')+' km/h';
    document.getElementById('journeyMinTime').textContent=formatDurationMinutes(minHours*60);

    const result=document.getElementById('journeyResult');
    if(implausible){
      result.className='journey-result anomaly';
      document.getElementById('journeyResultTitle').textContent='MOVEMENT ANOMALY — REQUIRES VERIFICATION';
      document.getElementById('journeyResultText').textContent=`The ${distance} km route would require an implied speed of ${Math.round(speed).toLocaleString('en-IN')} km/h. The event pair is therefore inconsistent with the prototype's ${105} km/h plausibility threshold.`;
    }else{
      result.className='journey-result consistent';
      document.getElementById('journeyResultTitle').textContent='MOVEMENT CONSISTENT';
      document.getElementById('journeyResultText').textContent=`The ${distance} km route and recorded elapsed time imply ${Math.round(speed*10)/10} km/h, which is within the prototype's plausibility threshold. A normal return journey is not penalized merely because the same registration appears again.`;
    }
  }

