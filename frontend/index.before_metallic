  function runBenchmark(size){
    const arr = []; const map = {};
    for(let i=0;i<size;i++){ const key = "REG-"+i; arr.push({key,val:i}); map[key]=i; }
    const target = "REG-"+(size-1);

    let t0 = performance.now();
    let found = -1;
    for(let i=0;i<arr.length;i++){ if(arr[i].key===target){ found=arr[i].val; break; } }
    const linearMs = performance.now()-t0;

    t0 = performance.now();
    const hashFound = map[target];
    const hashMs = performance.now()-t0;

    const risks = new Array(size);
    for(let i=0;i<size;i++) risks[i] = Math.floor(Math.random()*100);

    t0 = performance.now();
    const sorted = risks.slice().sort((a,b)=>b-a);
    const sortMs = performance.now()-t0;

    t0 = performance.now();
    const heap = new MaxHeap();
    for(let i=0;i<risks.length;i++) heap.push({risk:risks[i]});
    const top = heap.pop();
    const heapMs = performance.now()-t0;

    return { size, linearMs, hashMs, sortMs, heapMs };
  }
