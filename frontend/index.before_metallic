  .gate-meta-card{ min-height:59px; padding:9px 11px; border:1px solid var(--border-glass); border-radius:9px; background:rgba(15,23,42,.018); display:flex; flex-direction:column; justify-content:center; }
  .gate-meta-card span{ font-size:8.5px; color:var(--text-3); text-transform:uppercase; letter-spacing:.6px; }
  .gate-meta-card b{ margin-top:4px; font:700 11.5px var(--font-display); color:var(--text-1); }
  .gate-status{ display:inline-flex; align-items:center; gap:6px; }
  .gate-status-dot{ width:7px; height:7px; border-radius:50%; background:var(--text-3); display:inline-block; }
  .gate-status.live{ color:var(--green); }
  .gate-status.live .gate-status-dot{ background:var(--green); box-shadow:0 0 0 4px rgba(23,138,80,.09); animation:blinkDot 1.4s ease-in-out infinite; }
  .gate-status.busy{ color:var(--amber); }
  .gate-status.busy .gate-status-dot{ background:var(--amber); }
  .auto-capture-box{ min-height:59px; border-radius:9px; border:1px solid rgba(23,138,80,.20); background:rgba(23,138,80,.055); padding:9px 11px; display:flex; align-items:center; gap:10px; }
  .auto-capture-box b{ display:block; font:700 10px var(--font-display); color:var(--green); letter-spacing:.2px; }
  .auto-capture-box span{ display:block; margin-top:3px; color:var(--text-3); font-size:8.5px; line-height:1.35; }
  .anpr-toggle{ transform:scale(.86); transform-origin:left center; margin-right:-7px; }
  .single-gate-stage{ margin-top:13px; grid-template-columns:minmax(0,1.55fr) minmax(250px,.72fr); }
  .gate-webcam-wrap{ min-height:0; aspect-ratio:16/9; }
  .gate-cam-chip{ z-index:5; }
  .single-scan-overlay{ position:absolute; inset:0; pointer-events:none; }
  .vehicle-guide{ position:absolute; left:12%; right:12%; top:14%; bottom:15%; border:1.5px dashed rgba(95,227,224,.78); border-radius:14px; background:rgba(95,227,224,.018); box-shadow:inset 0 0 0 1px rgba(95,227,224,.055),0 0 30px rgba(95,227,224,.03); }
  .vehicle-guide span,.plate-guide span{ position:absolute; font-size:8.5px; letter-spacing:1px; font-weight:700; color:#8FE3E0; background:rgba(2,5,10,.78); border:1px solid rgba(95,227,224,.18); padding:5px 7px; border-radius:5px; white-space:nowrap; }
  .vehicle-guide span{ top:7px; left:8px; }
