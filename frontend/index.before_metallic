  function pathLength(pts){
    let t=0;
    for(let i=1;i<pts.length;i++){ t += Math.hypot(pts[i].x-pts[i-1].x, pts[i].y-pts[i-1].y); }
    return t;
  }
  function pointAtDistance(pts, dist){
    let remaining = dist;
    for(let i=1;i<pts.length;i++){
      const dx=pts[i].x-pts[i-1].x, dy=pts[i].y-pts[i-1].y;
      const segLen = Math.hypot(dx,dy);
      if(remaining <= segLen || i === pts.length-1){
        const t = segLen ? Math.min(remaining/segLen,1) : 0;
        return { x:pts[i-1].x+dx*t, y:pts[i-1].y+dy*t, fromIdx:i-1 };
      }
      remaining -= segLen;
    }
    return { x:pts[0].x, y:pts[0].y, fromIdx:0 };
  }

