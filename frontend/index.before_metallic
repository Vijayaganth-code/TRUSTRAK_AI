  function buildLinePath(values, w, h, pad, max){
    const n = values.length;
    const stepX = (w - pad*2) / (n-1);
    return values.map((v,i) => {
      const x = pad + i*stepX;
      const y = h - pad - (v/max)*(h - pad*2);
      return {x,y};
    });
  }

