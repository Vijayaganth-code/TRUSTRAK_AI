  /* ---------- placeholder view ---------- */
  .placeholder-panel{ padding:56px 30px; text-align:center; }
  .placeholder-panel .pi{ width:52px; height:52px; border-radius:14px; margin:0 auto 18px; display:flex; align-items:center; justify-content:center; background:var(--gold-dim); color:var(--gold-bright); }
  .placeholder-panel .pi svg{ width:24px; height:24px; }
  .placeholder-panel h2{ font-size:18px; font-weight:700; }
  .placeholder-panel p{ font-size:12.5px; color:var(--text-2); max-width:440px; margin:10px auto 0; line-height:1.65; }
