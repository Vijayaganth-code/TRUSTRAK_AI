  function buildLiveGraphModel(ctx){
    const vehicle = ctx.vehicle || {};
    const nodes = [
      {id:"vehicle", label:ctx.plate, x:240, y:42, color:"var(--gold-bright)", r:10},
      {id:"operator", label:vehicle.operator || "Operator unavailable", x:410, y:42, color:"var(--blue)", r:8},
      {id:"fastag", label:vehicle.fastag_id || "FASTag unavailable", x:70, y:42, color:"var(--purple)", r:8},
      {id:"permit", label:"Permit: " + (vehicle.permit_status || "—"), x:240, y:118,
        color:String(vehicle.permit_status || "").toUpperCase() === "VALID" ? "var(--green)" : "var(--red)", r:8},
      {id:"fitness", label:"Fitness: " + (vehicle.fitness_status || "—"), x:240, y:168,
        color:String(vehicle.fitness_status || "").toUpperCase() === "VALID" ? "var(--green)" : "var(--red)", r:8}
    ];

    const edges = [
      {a:"vehicle",b:"operator",bad:false},
      {a:"vehicle",b:"fastag",bad:false},
      {a:"vehicle",b:"permit",bad:String(vehicle.permit_status || "").toUpperCase() !== "VALID"},
      {a:"vehicle",b:"fitness",bad:String(vehicle.fitness_status || "").toUpperCase() !== "VALID"}
    ];

    const seenLocations = new Set();
    (ctx.events || []).slice(0, 4).forEach((event, index) => {
      const location = event.location || "Unknown";
      const key = String(location).toUpperCase();
      if(seenLocations.has(key)) return;
      seenLocations.add(key);

      const id = "sight" + index;
      const x = 90 + index * 110;
      const y = 222;

      nodes.push({
        id,
        label:location,
        x,
        y,
        color:"var(--text-2)",
        r:6
      });

      edges.push({
        a:"vehicle",
        b:id,
        bad:false
      });
    });

    return {nodes, edges};
  }

  function renderLiveGraph(ctx){
    const wrap = document.getElementById("graphSvgWrap");
    const trace = document.getElementById("bfsTrace");
    if(!wrap || !trace) return;

    const model = buildLiveGraphModel(ctx);
    const byId = Object.fromEntries(model.nodes.map(n => [n.id, n]));

    let svg = `<svg viewBox="0 0 480 255" style="width:100%;max-width:480px;height:auto;">`;

    model.edges.forEach(edge => {
      const a = byId[edge.a];
      const b = byId[edge.b];
      if(!a || !b) return;

      svg += `
        <line
          x1="${a.x}" y1="${a.y}"
          x2="${b.x}" y2="${b.y}"
          stroke="${edge.bad ? 'var(--red)' : 'var(--border-glass)'}"
          stroke-width="${edge.bad ? 2 : 1.5}"
          ${edge.bad ? 'stroke-dasharray="4 3"' : ''}
        />`;
    });

    model.nodes.forEach(node => {
      svg += `
        <circle cx="${node.x}" cy="${node.y}" r="${node.r}" fill="${node.color}"></circle>
        <text
          x="${node.x}"
          y="${node.y - node.r - 7}"
          text-anchor="middle"
          font-size="9.5"
          fill="var(--text-1)"
          font-family="Inter, sans-serif"
        >${graphSafe(node.label)}</text>`;
    });

    svg += `</svg>`;
    wrap.innerHTML = svg;

    const adjacency = {};
    function addEdge(a,b){
      (adjacency[a] ||= new Set()).add(b);
      (adjacency[b] ||= new Set()).add(a);
    }
    model.edges.forEach(e => addEdge(e.a, e.b));

    const visited = new Set(["vehicle"]);
    const queue = [["vehicle",0]];
    const order = [];

    while(queue.length){
      const [node, depth] = queue.shift();
      order.push(node);
      if(depth >= 2) continue;

      (adjacency[node] || new Set()).forEach(next => {
        if(!visited.has(next)){
          visited.add(next);
          queue.push([next, depth + 1]);
        }
      });
    }

    const labels = order.map(id => {
      if(id === "vehicle") return ctx.plate;
      if(id === "operator") return ctx.vehicle?.operator || "Operator";
      if(id === "fastag") return ctx.vehicle?.fastag_id || "FASTag";
      if(id === "permit") return "Permit";
      if(id === "fitness") return "Fitness";
      return byId[id]?.label || id;
    });

    trace.textContent =
      "BFS traversal (depth 2): " + labels.join(" → ");
  }

