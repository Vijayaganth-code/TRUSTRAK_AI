  /* ---------- Trie: registration-number autocomplete ---------- */
  class TrieNode{ constructor(){ this.children = {}; this.isEnd = false; } }
  class Trie{
    constructor(){ this.root = new TrieNode(); }
    insert(word){
      let node = this.root;
      for(const ch of word){
        if(!node.children[ch]) node.children[ch] = new TrieNode();
        node = node.children[ch];
      }
      node.isEnd = true;
    }
    _collect(node, prefix, out){
      if(node.isEnd) out.push(prefix);
      for(const ch in node.children) this._collect(node.children[ch], prefix+ch, out);
    }
    startsWith(prefix){
      let node = this.root;
      for(const ch of prefix){
        if(!node.children[ch]) return [];
        node = node.children[ch];
      }
      const out = [];
      this._collect(node, prefix, out);
      return out.sort();
    }
  }
  const plateTrie = new Trie();
