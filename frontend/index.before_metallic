  class MaxHeap{
    constructor(){ this.data=[]; }
    get size(){ return this.data.length; }
    _swap(i,j){ const t=this.data[i]; this.data[i]=this.data[j]; this.data[j]=t; }
    push(item){
      this.data.push(item); let i=this.data.length-1;
      while(i>0){ const p=Math.floor((i-1)/2); if(this.data[p].risk>=this.data[i].risk) break; this._swap(p,i); i=p; }
    }
    pop(){
      if(!this.data.length) return null;
      const top=this.data[0]; const last=this.data.pop();
      if(this.data.length){
        this.data[0]=last; let i=0;
        while(true){
          const l=2*i+1,r=2*i+2; let m=i;
          if(l<this.data.length && this.data[l].risk>this.data[m].risk) m=l;
          if(r<this.data.length && this.data[r].risk>this.data[m].risk) m=r;
          if(m===i) break; this._swap(i,m); i=m;
        }
      }
      return top;
    }
    toSortedArray(){ const c=new MaxHeap(); c.data=this.data.slice(); const out=[]; while(c.size) out.push(c.pop()); return out; }
  }

  const cloneTravel = travelPlausibility("Chennai","Coimbatore",27);
  const impossibleTravel2 = travelPlausibility("Trichy","Madurai",18);

