  async function captureCurrentVehicle(source='manual',det=null){
    if(autoCaptureBusy) return;
    if(!physicalStream || !physicalVideo.videoWidth){ toast('Start the laptop camera first.'); return; }
    autoCaptureBusy=true;
    setDetectionState('CAPTURING ANPR…');
    setGateStatus('SCANNING…','busy');
    ['stepDetect','stepOCR','stepLookup','stepRecord'].forEach(id=>setPipelineStep(id,''));
    setPipelineStep('stepDetect','done');
    try{
      det=det || await getCurrentVehicleDetection();
      const observedType=det?vehicleTypeShort(det.class):'Unknown';
      document.getElementById('stableFrameReadout').textContent=STABLE_FRAME_TARGET+' / '+STABLE_FRAME_TARGET;
      setPipelineStep('stepOCR','busy');
      const ocr=await ocrVehicle(physicalVideo,det);
      if(!ocr.text){
        setDetectionState('PLATE NOT READ');
        setPipelineStep('stepOCR','');
        toast('Vehicle detected but no readable plate was recovered from this frame.');
        return;
      }
      setPipelineStep('stepOCR','done');
      setPipelineStep('stepLookup','busy');
      const event=await createAnprEvent(ocr,observedType,source);
      setPipelineStep('stepLookup',event?.registryMatch?'done':'busy');
      if(event){
        setPipelineStep('stepRecord','done');
        setPipelineStep('stepLookup','done');
        setDetectionState(event.registryMatch?'EVENT RECORDED · REGISTRY MATCH':'EVENT RECORDED · NO REGISTRY MATCH');
        toast(`${displayPlate(event.plate)} recorded at ${event.gate}.`);
      }
      lastAutoCaptureAt=Date.now();
      stableFrames=0;
      lastDetectionSignature='';
    }catch(e){
      console.error(e);
      setDetectionState('ANPR SCAN ERROR');
      toast('ANPR scan failed. Keep the plate large, horizontal and well lit, then retry.');
    }finally{
      autoCaptureBusy=false;
      if(physicalStream) setGateStatus('LIVE · WATCHING','live');
    }
  }

  async function autoCaptureTick(){
    if(!autoCaptureEnabled || !physicalStream || autoCaptureBusy || !physicalDetector) return;
    const det=await getCurrentVehicleDetection();
    if(!det){
      stableFrames=0; lastDetectionSignature='';
      document.getElementById('stableFrameReadout').textContent='0 / '+STABLE_FRAME_TARGET;
      setDetectionState('WATCHING FOR VEHICLE');
      setPipelineStep('stepDetect','active');
      return;
    }
    const sig=detectionSignature(det);
    if(sig && sig===lastDetectionSignature) stableFrames++; else stableFrames=1;
    lastDetectionSignature=sig;
    document.getElementById('stableFrameReadout').textContent=Math.min(stableFrames,STABLE_FRAME_TARGET)+' / '+STABLE_FRAME_TARGET;
    setDetectionState(`${vehicleTypeShort(det.class).toUpperCase()} DETECTED · ${Math.round((det.score||0)*100)}%`);
    setPipelineStep('stepDetect',stableFrames>=STABLE_FRAME_TARGET?'done':'busy');
    if(stableFrames>=STABLE_FRAME_TARGET && Date.now()-lastAutoCaptureAt>AUTO_CAPTURE_COOLDOWN_MS){
      await captureCurrentVehicle('auto',det);
    }
  }
  function startAutoCaptureLoop(){
    if(autoCaptureTimer) return;
    autoCaptureTimer=setInterval(()=>{ autoCaptureTick().catch(e=>console.warn(e)); },900);
  }
  function stopAutoCaptureLoop(){ if(autoCaptureTimer){ clearInterval(autoCaptureTimer); autoCaptureTimer=null; } }

